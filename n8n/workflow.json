{
  "id": "jobhuntautopilot",
  "name": "Job Hunt Autopilot",
  "nodes": [
    {
      "id": "n1",
      "name": "Daily",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 9
            }
          ]
        }
      }
    },
    {
      "id": "n2",
      "name": "Get jobs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000,
      "parameters": {
        "url": "={{ $env.API_URL }}/jobs",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Secret",
              "value": "={{ $env.API_SHARED_SECRET }}"
            }
          ]
        },
        "options": {
          "timeout": 180000
        }
      }
    },
    {
      "id": "n3",
      "name": "Skip seen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "jsCode": "// Drop jobs already analyzed in earlier runs (ids are recorded after analysis, below).\nconst seen = $getWorkflowStaticData('global').seen || {};\nreturn $input.all().filter((i) => i.json.job_id && !seen[i.json.job_id]);\n"
      }
    },
    {
      "id": "n4",
      "name": "Analyze",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        0
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000,
      "onError": "continueRegularOutput",
      "parameters": {
        "method": "POST",
        "url": "={{ $env.API_URL }}/analyze",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Secret",
              "value": "={{ $env.API_SHARED_SECRET }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 300000,
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 60000
            }
          }
        }
      }
    },
    {
      "id": "n5",
      "name": "Filter and format",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        0
      ],
      "parameters": {
        "jsCode": "const MIN_SCORE = 40;      // only notify at or above this score\nconst KEEP_DAYS = 60;      // forget seen ids after this long\n\nconst store = $getWorkflowStaticData('global');\nstore.seen = store.seen || {};\nconst now = Date.now();\nfor (const id of Object.keys(store.seen)) {\n  if (now - store.seen[id] > KEEP_DAYS * 864e5) delete store.seen[id];\n}\n\nconst jobs = Object.fromEntries($('Skip seen').all().map((i) => [i.json.job_id, i.json]));\nconst out = [];\nfor (const { json: a } of $input.all()) {\n  const job = jobs[a.job_id];\n  // A failed /analyze has no score: leave it unseen so tomorrow's run retries it.\n  if (!job || typeof a.score !== 'number') continue;\n  store.seen[a.job_id] = now;\n  if (a.score < MIN_SCORE) continue;\n\n  const lines = [\n    `**${job.title}** at ${job.company} - score ${a.score} (semantic ${a.semantic_score}, keyword ${a.keyword_score})`,\n    `${job.location} | via ${job.source}`,\n    job.url,\n    `Matched: ${a.matched_skills.join(', ') || '-'}`,\n    `Gaps: ${a.gaps.join(', ') || '-'}`,\n    a.summary,\n  ];\n  if (job.source === 'remotive') lines.push('Source: Remotive (remotive.com)');\n  if (!a.skipped_email) lines.push('', `**${a.email_subject}**`, a.email_draft);\n  out.push({ json: { content: lines.join('\\n').slice(0, 1900) } }); // Discord caps messages at 2000 chars\n}\nreturn out;\n"
      }
    },
    {
      "id": "n6",
      "name": "Discord",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.DISCORD_WEBHOOK_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ content: $json.content }) }}",
        "options": {
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 1500
            }
          }
        }
      }
    }
  ],
  "connections": {
    "Daily": {
      "main": [
        [
          {
            "node": "Get jobs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get jobs": {
      "main": [
        [
          {
            "node": "Skip seen",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Skip seen": {
      "main": [
        [
          {
            "node": "Analyze",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Analyze": {
      "main": [
        [
          {
            "node": "Filter and format",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Filter and format": {
      "main": [
        [
          {
            "node": "Discord",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
